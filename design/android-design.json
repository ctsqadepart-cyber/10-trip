    "primaryActions": "bottom_of_form_with_keyboard_insets_in_native_app"
  },
  "screens": [
    {"id": "trips", "title": "我的旅程", "actions": ["create_trip", "open_trip", "quick_add", "open_diary"], "empty": "還沒有旅程，先記錄日常也可以。"},
    {"id": "trip_records", "title": "旅程紀錄", "actions": ["select_local_date", "open_record", "add_record", "open_members"], "empty": "這一天，還沒有紀錄。"},
    {"id": "diary", "title": "日常紀錄", "visibility": "private", "actions": ["add_record", "open_record", "share_to_trip"]},
    {"id": "record_detail", "title": "紀錄內容", "actions": ["edit", "manage_photos", "manage_audio", "open_linked_expense", "delete_with_impact_confirmation"]},
    {"id": "record_editor", "title": "記下這一刻", "required": ["at_least_one_meaningful_content"], "defaults": ["occurred_at_now"], "optional": ["title", "text", "location", "photos", "audio", "meals", "expenses"], "actions": ["save", "capture_photo", "pick_local_photo", "record_audio", "request_one_location", "add_expense"]},
    {"id": "photos", "title": "照片", "actions": ["capture", "pick_multiple", "reorder", "edit_caption", "remove_app_copy"], "forbidden": ["delete_gallery_original"]},
    {"id": "audio", "title": "語音筆記", "states": ["idle", "recording", "finalizing", "saved", "interrupted", "permission_denied", "failed"], "actions": ["record", "stop", "play", "rename", "delete"]},
    {"id": "expenses", "title": "費用", "views": ["daily", "whole_trip", "category", "member_balance"]},
    {"id": "expense_editor", "title": "這筆，怎麼分？", "fields": ["category", "original_amount", "currency", "rate_direction", "rate", "converted_amount", "payer", "participants", "split_mode", "shares"], "validation": ["positive_amount", "positive_rate", "at_least_one_participant", "sum_shares_equals_expense"]},
    {"id": "share_preview", "title": "確認加入並分享", "mustShow": ["target_trip", "recipient_members", "included_content", "linked_expenses", "member_mapping", "currency_effect", "trip_total_before_after"], "consentRequired": true},
    {"id": "members", "title": "一起旅行的人", "identity": "stable_local_member_id_independent_of_account", "adminRole": "owner_only"},
    {"id": "settings", "title": "安心留在手邊", "phase2Preview": ["unencrypted_backup_warning", "restore_validation", "export_privacy_selection"]}
