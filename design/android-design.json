  "localDataDesign": {
    "database": "Room_SQLite",
    "attachmentStorage": "app_private_persistent_files_not_cache",
    "draftStorage": "persistent_draft_distinct_from_saved_record",
    "transactionBoundary": "record_children_links_and_outbox_are_atomic",
    "identifiers": "UUID_generated_offline",
    "entities": {
      "Trip": ["id", "title", "startDate", "endDate", "settlementCurrency", "ownerMemberId"],
      "Record": ["id", "privateOwnerId", "tripId_nullable", "occurredAt", "zoneId", "localDate", "title", "text", "placeName", "latitude_nullable", "longitude_nullable", "locationAccuracy_nullable", "locationCapturedAt_nullable", "locationSource"],
      "Attachment": ["id", "recordId", "kind", "privateRelativePath", "sha256", "sizeBytes", "mimeType", "sortIndex", "captionOrName", "durationMs_nullable", "transferState"],
      "Meal": ["id", "recordId", "storeName", "rating_nullable", "notes", "expenseId_nullable"],
      "Dish": ["id", "mealId", "name", "quantityDecimal", "unitAmountMinor", "currency", "rating_nullable", "notes", "sortIndex"],
      "Expense": ["id", "recordId_nullable", "tripId_nullable", "localDate", "category", "originalAmountMinor", "originalCurrency", "settlementCurrency", "rateDecimalString", "settledAmountMinor", "payerMemberId", "roundingPolicyVersion", "splitMode"],
      "ExpenseShare": ["expenseId", "memberId", "settledAmountMinor", "stableRemainderOrder"],
      "Member": ["id", "tripId_nullable", "displayName", "linkedAccountId_nullable", "active"],
      "ExchangeRatePreset": ["id", "tripId_nullable", "sourceCurrency", "settlementCurrency", "rateDecimalString", "effectiveForNewExpenses"],
      "OutboxOperation": ["operationId", "entityId", "aggregateId", "baseServerRevision_nullable", "localRevision", "payloadSnapshot", "status"],
      "Conflict": ["id", "aggregateId", "baseSnapshot", "localSnapshot", "remoteSnapshot", "resolutionState"]
    },
    "syncMetadataForSyncableEntities": ["schemaVersion", "localRevision", "baseServerRevision_nullable", "changedByLocalActorId", "deviceId", "deletedFlag", "modifiedAt_display_only"],
    "futureServerRules": ["revision_compare_and_swap", "operation_id_idempotency", "server_member_authorization_for_rows_and_files", "owner_only_membership_mutations", "manual_batch_only_no_realtime_subscription", "preserve_delete_edit_conflicts", "do_not_gc_conflict_attachments"],
    "futureBackupRules": ["manifest_and_hashes", "format_version", "exclude_credentials_and_map_cache", "staging_validation_before_commit", "same_id_same_content_skip", "same_id_different_content_preserve_both", "restored_revision_not_automatically_server_authoritative"]
  },
  "moneyPolicy": {
    "amountRepresentation": "integer_minor_units",
    "rates": "exact_decimal_string",
    "rounding": "HALF_UP_once_to_settlement_currency_minor_unit",
    "splitOrder": "convert_total_then_split",
    "equalSplitRemainder": "fixed_stable_member_order_not_display_sort",
    "customSplitCurrency": "trip_settlement_currency",
    "rateChangeDefault": "new_expenses_only",
    "revalueExisting": "explicit_selection_and_impact_preview_then_confirm",
    "currencyChangeWithExpenses": "dedicated_revaluation_flow",
    "rating": {"minimum": 1, "maximum": 5, "step": 1, "unset": null}
  },
  "prototypeLimitations": [
    "示範資料僅存在本次原型記憶體，重新載入會重設",
